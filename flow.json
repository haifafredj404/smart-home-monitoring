        "format": "<style>\n  .vp-wrap {\n    --fg: #fff; --fg2: rgba(255,255,255,.7);\n    --card: rgba(255,255,255,.14); --cardb: rgba(255,255,255,.28); --track: rgba(255,255,255,.2);\n    width: 100%; box-sizing: border-box; padding: 22px 18px; border-radius: 32px; overflow: hidden;\n    font-family: -apple-system, \"SF Pro Display\", \"Segoe UI\", Roboto, sans-serif; color: var(--fg);\n    background:\n      radial-gradient(circle at 15% 20%, #5b8cff 0%, transparent 45%),\n      radial-gradient(circle at 85% 80%, #b06cff 0%, transparent 45%),\n      radial-gradient(circle at 70% 15%, #29d3c6 0%, transparent 40%),\n      #0f1226;\n  }\n  .vp-wrap.light {\n    --fg: #14182d; --fg2: rgba(20,24,45,.65);\n    --card: rgba(255,255,255,.55); --cardb: rgba(255,255,255,.95); --track: rgba(20,24,45,.12);\n    background:\n      radial-gradient(circle at 15% 20%, #a9c1ff 0%, transparent 45%),\n      radial-gradient(circle at 85% 80%, #e0c4ff 0%, transparent 45%),\n      radial-gradient(circle at 70% 15%, #a8f0e8 0%, transparent 40%),\n      #eef2fb;\n  }\n  .vp-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; margin-bottom: 14px; }\n  .vp-title, .vp-head { background: transparent !important; color: var(--fg) !important; padding: 0; }\n  .vp-title { font-size: 12px; letter-spacing: .18em; text-transform: uppercase; opacity: .7; margin: 0 0 2px 4px; }\n  .vp-head  { font-size: 26px; font-weight: 600; margin: 0 0 0 4px; }\n  .vp-tools { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }\n  .vp-status { display: flex; align-items: center; gap: 7px; font-size: 12px; padding: 7px 12px; border-radius: 999px;\n               background: var(--card); border: 1px solid var(--cardb); color: var(--fg); }\n  .vp-led { width: 9px; height: 9px; border-radius: 50%; background: #888; }\n  .vp-led.ok { background: #30d158; box-shadow: 0 0 8px #30d158; }\n  .vp-led.ko { background: #ff453a; box-shadow: 0 0 8px #ff453a; }\n  .vp-btn { cursor: pointer; border: 1px solid var(--cardb); background: var(--card); color: var(--fg);\n            border-radius: 999px; padding: 7px 12px; font-size: 13px; }\n\n  .vp-alert { margin-bottom: 14px; padding: 12px 16px; border-radius: 18px; font-size: 14px; font-weight: 500;\n              background: rgba(48,209,88,.25); border: 1px solid rgba(48,209,88,.6); color: var(--fg); }\n  .vp-alert.warn   { background: rgba(255,214,10,.28); border-color: rgba(255,214,10,.8); }\n  .vp-alert.danger { background: rgba(255,69,58,.32);  border-color: rgba(255,69,58,.85); }\n\n    .vp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }\n    @media (max-width: 700px) { .vp-grid { grid-template-columns: 1fr; } }\n  .vp-card { min-width: 0; box-sizing: border-box; padding: 18px 14px 16px; border-radius: 26px;\n             background: var(--card); backdrop-filter: blur(28px) saturate(160%); -webkit-backdrop-filter: blur(28px) saturate(160%);\n             border: 1px solid var(--cardb); box-shadow: inset 0 1px 0 rgba(255,255,255,.45), 0 16px 32px rgba(0,0,0,.2);\n             text-align: center; color: var(--fg); }\n  .vp-wide { grid-column: 1 / -1; text-align: left; }\n  .vp-label { display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 14px; font-weight: 500; }\n  .vp-wide .vp-label { justify-content: flex-start; }\n\n  .vp-gauge { position: relative; width: 100%; max-width: 130px; aspect-ratio: 1/1; margin: 12px auto 0; }\n  .vp-gauge svg { width: 100%; height: 100%; transform: rotate(-90deg); }\n  .vp-track { fill: none; stroke: var(--track); stroke-width: 12; }\n  .vp-bar { fill: none; stroke-width: 12; stroke-linecap: round;\n            transition: stroke-dashoffset .8s cubic-bezier(.4,0,.2,1), stroke .4s; filter: drop-shadow(0 0 6px currentColor); }\n  .vp-value { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }\n  .vp-value b { font-size: 30px; font-weight: 600; line-height: 1; color: var(--fg) !important; background: transparent !important; }\n  .vp-value small { font-size: 11px; color: var(--fg2) !important; margin-top: 4px; background: transparent !important; }\n\n  .vp-motion { min-height: 130px; margin-top: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; }\n  .vp-pill { padding: 8px 18px; border-radius: 999px; font-size: 15px; font-weight: 600; letter-spacing: .05em;\n             background: rgba(80,220,140,.28); border: 1px solid rgba(120,240,170,.6); color: var(--fg); transition: all .3s; }\n  .vp-pill.on { background: rgba(255,99,99,.4); border-color: rgba(255,140,140,.8); box-shadow: 0 0 22px rgba(255,99,99,.65); }\n  .vp-dot { width: 14px; height: 14px; border-radius: 50%; background: #50dc8c; box-shadow: 0 0 14px #50dc8c; }\n  .vp-dot.on { background: #ff6363; box-shadow: 0 0 18px #ff6363; animation: vp-pulse 1s infinite; }\n  @keyframes vp-pulse { 50% { transform: scale(1.5); opacity: .6; } }\n\n  .vp-chart-head { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 6px; font-size: 12px; color: var(--fg2); margin-top: 6px; }\n  .vp-chart svg { width: 100%; height: 160px; margin-top: 10px; display: block; }\n  .vp-legend { display: flex; gap: 14px; font-size: 12px; color: var(--fg2); margin-top: 8px; }\n  .vp-legend i { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 6px; }\n  .vp-events { list-style: none; margin: 10px 0 0; padding: 0; font-size: 13px; color: var(--fg); }\n  .vp-events li { padding: 7px 0; border-bottom: 1px solid var(--track); display: flex; justify-content: space-between; }\n  .vp-events li:last-child { border-bottom: 0; }\n</style>\n\n<div class=\"vp-wrap\" id=\"vp-root\">\n  <div class=\"vp-top\">\n    <div>\n            <div class=\"vp-title\" style=\"background:transparent!important;color:var(--fg)!important\">Smart Home</div>\n            <div class=\"vp-head\" style=\"background:transparent!important;color:var(--fg)!important\">Monitoring</div>\n    </div>\n    <div class=\"vp-tools\">\n      <div class=\"vp-status\"><span class=\"vp-led\" id=\"vp-led\"></span><span id=\"vp-online\">En attente…</span></div>\n      <button class=\"vp-btn\" id=\"vp-theme\">🌓 Thème</button>\n    </div>\n  </div>\n\n  <div class=\"vp-alert\" id=\"vp-alert\">✅ Tout est normal</div>\n\n  <div class=\"vp-grid\">\n    <div class=\"vp-card\">\n      <div class=\"vp-label\"><span>🌡️</span>Température</div>\n      <div class=\"vp-gauge\">\n        <svg viewBox=\"0 0 120 120\">\n          <circle class=\"vp-track\" cx=\"60\" cy=\"60\" r=\"52\"/>\n          <circle class=\"vp-bar\" id=\"vp-t-bar\" cx=\"60\" cy=\"60\" r=\"52\" stroke-dasharray=\"326.7\" stroke-dashoffset=\"326.7\" style=\"color:#ffd60a;stroke:#ffd60a\"/>\n        </svg>\n        <div class=\"vp-value\"><b id=\"vp-t-val\">--</b><small>°C · 0–50</small></div>\n      </div>\n    </div>\n\n    <div class=\"vp-card\">\n      <div class=\"vp-label\"><span>💧</span>Humidité</div>\n      <div class=\"vp-gauge\">\n        <svg viewBox=\"0 0 120 120\">\n          <circle class=\"vp-track\" cx=\"60\" cy=\"60\" r=\"52\"/>\n          <circle class=\"vp-bar\" id=\"vp-h-bar\" cx=\"60\" cy=\"60\" r=\"52\" stroke-dasharray=\"326.7\" stroke-dashoffset=\"326.7\" style=\"color:#64d2ff;stroke:#64d2ff\"/>\n        </svg>\n        <div class=\"vp-value\"><b id=\"vp-h-val\">--</b><small>% · 0–100</small></div>\n      </div>\n    </div>\n\n    <div class=\"vp-card\">\n      <div class=\"vp-label\"><span>🚶</span>Mouvement</div>\n      <div class=\"vp-motion\">\n        <div class=\"vp-dot\" id=\"vp-m-dot\"></div>\n        <div class=\"vp-pill\" id=\"vp-m-pill\">AUCUN</div>\n      </div>\n    </div>\n\n    <div class=\"vp-card vp-wide vp-chart\">\n      <div class=\"vp-label\"><span>📈</span>Historique</div>\n      <div class=\"vp-chart-head\">\n        <span id=\"vp-stats\">Min -- · Moy -- · Max -- °C</span>\n        <span id=\"vp-range\">--</span>\n      </div>\n      <svg viewBox=\"0 0 600 160\" preserveAspectRatio=\"none\">\n        <line x1=\"0\" y1=\"80\" x2=\"600\" y2=\"80\" stroke=\"currentColor\" stroke-opacity=\".15\" stroke-dasharray=\"4 6\"/>\n        <path id=\"vp-c-area\" d=\"\" fill=\"#ffd60a\" fill-opacity=\".12\"/>\n        <path id=\"vp-c-t\" d=\"\" fill=\"none\" stroke=\"#ffd60a\" stroke-width=\"2.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>\n        <path id=\"vp-c-h\" d=\"\" fill=\"none\" stroke=\"#64d2ff\" stroke-width=\"2.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>\n      </svg>\n      <div class=\"vp-legend\">\n        <span><i style=\"background:#ffd60a\"></i>Température</span>\n        <span><i style=\"background:#64d2ff\"></i>Humidité</span>\n      </div>\n    </div>\n\n    <div class=\"vp-card vp-wide\">\n      <div class=\"vp-label\"><span>🕘</span>Derniers mouvements</div>\n      <ul class=\"vp-events\" id=\"vp-events\"><li>Aucun événement</li></ul>\n    </div>\n  </div>\n</div>\n\n<script>\n(function (scope) {\n  var C = 326.7, lastSeen = 0;\n  var $ = function (id) { return document.getElementById(id); };\n  var fmt = function (ts) { return new Date(ts).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }); };\n\n  function tColor(t) { return t < 15 ? '#64d2ff' : t < 26 ? '#30d158' : t < 33 ? '#ffd60a' : '#ff453a'; }\n\n  function setGauge(barId, valId, value, min, max, col) {\n    var bar = $(barId), val = $(valId);\n    if (!bar || !val) return;\n    var pct = Math.max(0, Math.min(1, (value - min) / (max - min)));\n    bar.style.strokeDashoffset = C * (1 - pct);\n    if (col) { bar.style.stroke = col; bar.style.color = col; }\n    val.textContent = Number(value).toFixed(1);\n  }\n\n  function path(h, key, min, max) {\n    var n = h.length, d = '';\n    for (var i = 0; i < n; i++) {\n      var x = i / (n - 1) * 600;\n      var v = Math.max(0, Math.min(1, (h[i][key] - min) / (max - min)));\n      d += (i ? 'L' : 'M') + x.toFixed(1) + ' ' + (150 - v * 140).toFixed(1);\n    }\n    return d;\n  }\n\n  function drawChart(h, s) {\n    if (!h || h.length < 2) return;\n    var pt = path(h, 'temp', 0, 50);\n    $('vp-c-t').setAttribute('d', pt);\n    $('vp-c-h').setAttribute('d', path(h, 'hum', 0, 100));\n    $('vp-c-area').setAttribute('d', pt + ' L600 150 L0 150 Z');\n    $('vp-range').textContent = fmt(h[0].t) + ' → ' + fmt(h[h.length - 1].t);\n    if (s) $('vp-stats').textContent = 'Min ' + s.min.toFixed(1) + ' · Moy ' + s.avg.toFixed(1) + ' · Max ' + s.max.toFixed(1) + ' °C';\n  }\n\n  function drawAlerts(alerts) {\n    var box = $('vp-alert');\n    if (!alerts || !alerts.length) { box.className = 'vp-alert'; box.textContent = '✅ Tout est normal'; return; }\n    var danger = alerts.some(function (a) { return a.level === 'danger'; });\n    box.className = 'vp-alert ' + (danger ? 'danger' : 'warn');\n    box.textContent = '⚠️ ' + alerts.map(function (a) { return a.text; }).join('  ·  ');\n  }\n\n  function drawEvents(ev) {\n    var ul = $('vp-events');\n    ul.innerHTML = '';\n    if (!ev || !ev.length) { var li0 = document.createElement('li'); li0.textContent = 'Aucun événement'; ul.appendChild(li0); return; }\n    ev.forEach(function (e) {\n      var li = document.createElement('li');\n      var a = document.createElement('span'); a.textContent = e.text;\n      var b = document.createElement('span'); b.textContent = new Date(e.t).toLocaleString();\n      li.appendChild(a); li.appendChild(b); ul.appendChild(li);\n    });\n  }\n\n  scope.$watch('msg', function (msg) {\n    if (!msg || !msg.payload || typeof msg.payload !== 'object') return;\n    var p = msg.payload;\n    lastSeen = Date.now();\n    setGauge('vp-t-bar', 'vp-t-val', p.temperature, 0, 50, tColor(p.temperature));\n    setGauge('vp-h-bar', 'vp-h-val', p.humidity, 0, 100);\n    var pill = $('vp-m-pill'), dot = $('vp-m-dot');\n    pill.textContent = p.motion ? 'DÉTECTÉ' : 'AUCUN';\n    pill.className = 'vp-pill' + (p.motion ? ' on' : '');\n    dot.className = 'vp-dot' + (p.motion ? ' on' : '');\n    drawChart(p.history, p.stats);\n    drawAlerts(p.alerts);\n    drawEvents(p.events);\n  });\n\n  // Statut en ligne / hors ligne\n  var timer = setInterval(function () {\n    var led = $('vp-led'), txt = $('vp-online');\n    if (!led || !txt || !lastSeen) return;\n    var s = Math.round((Date.now() - lastSeen) / 1000);\n    var ok = s < 30;\n    led.className = 'vp-led ' + (ok ? 'ok' : 'ko');\n    txt.textContent = ok ? 'En ligne · il y a ' + s + ' s' : 'Capteur hors ligne';\n  }, 1000);\n  scope.$on('$destroy', function () { clearInterval(timer); });\n\n  // Thème clair / sombre mémorisé\n  var root = $('vp-root');\n  try { if (localStorage.getItem('vp-theme') === 'light') root.classList.add('light'); } catch (e) {}\n  $('vp-theme').addEventListener('click', function () {\n    root.classList.toggle('light');\n    try { localStorage.setItem('vp-theme', root.classList.contains('light') ? 'light' : 'dark'); } catch (e) {}\n  });\n})(scope);\n</script>",
